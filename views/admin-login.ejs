<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Giving Records Admin</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
</head>
<body class="min-h-screen bg-stone-100 text-stone-900">
  <main class="grid min-h-screen place-items-center px-6 py-10">
    <section class="w-full max-w-md rounded-xl border border-stone-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-bold uppercase tracking-wider text-orange-700">Giving administration</p>
      <h1 class="mt-2 text-3xl font-black">歷史奉獻紀錄</h1>
      <p class="mt-3 text-sm text-stone-600">請輸入管理員代碼以檢視或刪除紀錄。</p>
      <form class="mt-7 space-y-4" action="<%= publicPathPrefix %>/rows/login" method="post">
        <label class="block text-sm font-semibold" for="code">管理員代碼
          <input id="code" name="code" type="password" autocomplete="current-password" required autofocus
            class="mt-2 block w-full rounded-md border-stone-300 px-3 py-3 focus:border-orange-600 focus:ring-orange-600" />
        </label>
        <% if (error) { %>
          <p class="rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-700"><%= error %></p>
        <% } %>
        <button class="w-full rounded-md bg-orange-700 px-4 py-3 font-bold text-white hover:bg-orange-800" type="submit">進入管理頁</button>
      </form>
    </section>
  </main>
</body>
</html>
