<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Giving Dashboard</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#e63c23",
                        "accent": "#0689c6",
                        "ink": "#000007",
                        "background-light": "#ede6da",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings:
                'FILL' 0,
                'wght' 400,
                'GRAD' 0,
                'opsz' 24
        }
        dialog::backdrop {
            background: rgba(0, 0, 7, 0.5);
        }
    </style>
</head>

<body class="font-display bg-background-light text-ink">
    <div class="flex min-h-screen">
        <main class="flex-1 p-8 overflow-y-auto w-full">
            <div class="max-w-7xl mx-auto">
                <div class="flex flex-col gap-3 mb-8 md:flex-row md:items-end md:justify-between">
                    <div>
                        <p class="text-4xl font-black leading-tight text-primary">Giving Dashboard</p>
                        <form action="<%= publicPathPrefix %>/stats" method="get" class="mt-2">
                            <label class="sr-only" for="dashboard-event">Dashboard event</label>
                            <select id="dashboard-event" name="eventId" onchange="this.form.submit()" class="rounded-md border-ink/20 bg-[#f8f3ea] px-3 py-2 text-sm font-bold text-ink focus:border-primary focus:ring-primary">
                                <% if (!events.length) { %><option value="">No events configured</option><% } %>
                                <% events.forEach((event) => { %>
                                    <option value="<%= event.id %>" <%= selectedEvent && event.id === selectedEvent.id ? 'selected' : '' %>><%= event.name %></option>
                                <% }) %>
                            </select>
                            <noscript><button class="ml-2 rounded-md bg-primary px-3 py-2 text-sm font-bold text-white" type="submit">View</button></noscript>
                        </form>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" aria-label="Event settings" title="Event settings"
                            onclick="document.getElementById('event-settings-dialog').showModal()"
                            class="grid size-10 place-items-center rounded-lg border border-ink/20 text-ink transition hover:border-primary hover:text-primary">
                            <span class="material-symbols-outlined">settings</span>
                        </button>
                        <form action="<%= publicPathPrefix %>/stats/logout" method="post">
                            <button type="submit"
                                class="rounded-lg border border-ink/20 px-4 py-2 text-sm font-bold text-ink transition hover:border-primary hover:text-primary">
                                Log out
                            </button>
                        </form>
                    </div>
                </div>

                <dialog id="event-settings-dialog" class="w-[calc(100%-2rem)] max-w-4xl rounded-xl border border-ink/10 bg-[#f8f3ea] p-0 text-ink shadow-2xl">
                    <section class="p-6">
                        <div class="mb-5 flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                        <div>
                            <p class="text-lg font-black text-primary">Event settings</p>
                            <p class="text-sm text-ink/60">Choose the event date range used by this dashboard. The latest event is selected by default.</p>
                        </div>
                            <form method="dialog"><button class="grid size-9 place-items-center rounded-md text-ink/60 hover:bg-ink/10 hover:text-ink" aria-label="Close event settings"><span class="material-symbols-outlined">close</span></button></form>
                        </div>
                        <% if (eventError) { %>
                            <p class="mb-4 rounded-md bg-red-100 px-3 py-2 text-sm font-medium text-red-800"><%= eventError %></p>
                        <% } %>
                        <div>
                            <form action="<%= publicPathPrefix %>/stats/events" method="post" class="grid gap-3 sm:grid-cols-4 sm:items-end">
                                <label class="text-sm font-bold text-ink/70">Event name
                                    <input required name="name" maxlength="120" class="mt-1 block w-full rounded-md border-ink/20 bg-white px-3 py-2 focus:border-primary focus:ring-primary" placeholder="Conf26" />
                                </label>
                                <label class="text-sm font-bold text-ink/70">Start date
                                    <input required name="startDate" type="date" class="mt-1 block w-full rounded-md border-ink/20 bg-white px-3 py-2 focus:border-primary focus:ring-primary" />
                                </label>
                                <label class="text-sm font-bold text-ink/70">End date
                                    <input required name="endDate" type="date" class="mt-1 block w-full rounded-md border-ink/20 bg-white px-3 py-2 focus:border-primary focus:ring-primary" />
                                </label>
                                <button type="submit" class="rounded-md bg-primary px-4 py-2 font-bold text-white transition hover:bg-primary/90">Add event</button>
                            </form>
                        </div>
                        <% if (events.length) { %>
                            <div class="mt-5 border-t border-ink/10 pt-4">
                                <p class="mb-2 text-sm font-bold text-ink/70">Configured events</p>
                                <div class="flex flex-wrap gap-2">
                                    <% events.forEach((event) => { %>
                                        <form action="<%= publicPathPrefix %>/stats/events/<%= event.id %>/delete" method="post" onsubmit="return confirm('Delete this event?');">
                                            <button type="submit" class="rounded-full border border-ink/20 px-3 py-1 text-sm text-ink hover:border-red-600 hover:text-red-700"><%= event.name %> · <%= event.start_date %> – <%= event.end_date %> ×</button>
                                        </form>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    </section>
                </dialog>
                <% if (eventError) { %><script>document.getElementById('event-settings-dialog').showModal();</script><% } %>

                <!-- Summary Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div
                        class="flex flex-col gap-3 rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-ink/70 text-base font-bold leading-normal">Total Giving</p>
                        <p class="text-4xl font-black leading-tight" id="total-giving-current">$0</p>
                    </div>
                    <div
                        class="flex flex-col gap-3 rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-ink/70 text-base font-bold leading-normal">Total Giving Counts</p>
                        <p class="text-4xl font-black leading-tight" id="total-count-current">0</p>
                    </div>
                </div>

                <!-- Campus Charts -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                    <div
                        class="flex flex-col gap-4 rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-lg font-black text-primary">Giving Sum by Campus</p>
                        <div class="h-64">
                            <canvas id="campusSumChart"></canvas>
                        </div>
                    </div>
                    <div
                        class="flex flex-col gap-4 rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-lg font-black text-primary">Giving Count by Campus</p>
                        <div class="h-64">
                            <canvas id="campusCountChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-8 mt-8">
                    <div
                        class="rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-lg font-black text-primary mb-1">Past 7 Days</p>
                        <p class="text-ink/60 text-sm font-normal mb-4">Daily giving sums (Taipei time, today included)</p>
                        <div class="h-72 w-full">
                            <canvas id="pastSevenDaysChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-8 mt-8">
                    <div
                        class="rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-lg font-black text-primary mb-1">Payment Method Stats</p>
                        <p class="text-ink/60 text-sm font-normal mb-4">Apple Pay, Google Pay, and credit card.</p>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <div>
                                <p class="mb-3 text-sm font-bold text-ink/70">Count Ratio</p>
                                <div class="h-72">
                                    <canvas id="paymentMethodCountChart"></canvas>
                                </div>
                            </div>
                            <div>
                                <p class="mb-3 text-sm font-bold text-ink/70">Amount Ratio</p>
                                <div class="h-72">
                                    <canvas id="paymentMethodAmountChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-8 mt-8">
                    <div
                        class="rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-lg font-black text-primary mb-1">Top 30 Givers</p>
                        <p class="text-ink/60 text-sm font-normal mb-4">Ranked by total giving amount in the selected event.</p>
                        <div class="h-[48rem] w-full">
                            <canvas id="topGiversChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Weekly Trend -->
                <div class="grid grid-cols-1 gap-8 mt-8">
                    <div
                        class="rounded-lg p-6 bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <p class="text-lg font-black text-primary mb-1">Weekly Giving Trend</p>
                        <p class="text-ink/60 text-sm font-normal mb-4">Weekly totals for the selected event.</p>
                        <div class="h-80 w-full">
                            <canvas id="weeklyTrendChart"></canvas>
                        </div>
                    </div>

                    <!-- Table -->
                    <div
                        class="overflow-x-auto rounded-lg bg-[#f8f3ea] border border-ink/10 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                        <table class="w-full text-left">
                            <thead
                                class="bg-[#ede6da] text-xs text-ink/65 uppercase">
                                <tr>
                                    <th class="px-6 py-3" scope="col">Week Period</th>
                                    <th class="px-6 py-3 text-right" scope="col">Amount</th>
                                    <th class="px-6 py-3 text-right" scope="col">Count</th>
                                </tr>
                            </thead>
                            <tbody class="text-sm text-ink/80" id="period-table-body">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- GA4 Summary -->
                <section class="mt-8" aria-labelledby="ga4-heading">
                    <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <p id="ga4-heading" class="text-2xl font-black text-accent">GA4 Website Performance</p>
                            <p class="text-sm text-ink/60">Uses the selected event date range.</p>
                        </div>
                    </div>
                    <% if (!ga4.available) { %>
                        <div class="rounded-lg border border-amber-600/30 bg-amber-50 px-5 py-4 text-sm font-medium text-amber-900"><%= ga4.message %></div>
                    <% } else { %>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
                            <div class="rounded-lg border border-ink/10 bg-[#f8f3ea] p-5 shadow-[0_12px_34px_rgba(0,0,7,0.06)]"><p class="text-sm font-bold text-ink/70">Active Users</p><p id="ga4-active-users" class="mt-2 text-3xl font-black">0</p></div>
                            <div class="rounded-lg border border-ink/10 bg-[#f8f3ea] p-5 shadow-[0_12px_34px_rgba(0,0,7,0.06)]"><p class="text-sm font-bold text-ink/70">New Users</p><p id="ga4-new-users" class="mt-2 text-3xl font-black">0</p></div>
                            <div class="rounded-lg border border-ink/10 bg-[#f8f3ea] p-5 shadow-[0_12px_34px_rgba(0,0,7,0.06)]"><p class="text-sm font-bold text-ink/70">Sessions</p><p id="ga4-sessions" class="mt-2 text-3xl font-black">0</p></div>
                            <div class="rounded-lg border border-ink/10 bg-[#f8f3ea] p-5 shadow-[0_12px_34px_rgba(0,0,7,0.06)]"><p class="text-sm font-bold text-ink/70">Page Views</p><p id="ga4-page-views" class="mt-2 text-3xl font-black">0</p></div>
                        </div>
                        <div class="mt-6 rounded-lg border border-ink/10 bg-[#f8f3ea] p-6 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                            <p class="mb-1 text-lg font-black text-accent">Daily Website Trend</p>
                            <p class="mb-4 text-sm text-ink/60">Daily active users, new users, sessions, and page views.</p>
                            <div class="h-80 w-full"><canvas id="ga4DailyTrendChart"></canvas></div>
                        </div>
                        <div class="mt-6 rounded-lg border border-ink/10 bg-[#f8f3ea] p-6 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                            <p class="mb-1 text-lg font-black text-accent">First Visit → Donation</p>
                            <p class="mb-4 text-sm text-ink/60">Days from first recorded GA4 visit to the <code class="rounded bg-ink/5 px-1"><%= ga4.postEffect?.donationEvent || 'purchase' %></code> event. This counts donation events, not deduplicated people.</p>
                            <div class="h-72 w-full"><canvas id="ga4PostEffectChart"></canvas></div>
                        </div>
                        <div class="mt-6 rounded-lg border border-ink/10 bg-[#f8f3ea] p-6 shadow-[0_12px_34px_rgba(0,0,7,0.06)]">
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                <div>
                                    <p class="mb-1 text-lg font-black text-accent">Giving Geography</p>
                                    <p class="text-sm text-ink/60">Aggregated by country from GA4. Locations are approximate and never identify individual people.</p>
                                </div>
                                <div class="flex flex-wrap gap-2" role="group" aria-label="Geography metric">
                                    <button type="button" data-geo-metric="activeUsers" class="geo-metric-button rounded-md bg-accent px-3 py-2 text-sm font-bold text-white">Visits</button>
                                    <button type="button" data-geo-metric="givingCount" class="geo-metric-button rounded-md border border-ink/20 px-3 py-2 text-sm font-bold text-ink hover:border-accent hover:text-accent">Giving counts</button>
                                    <button type="button" data-geo-metric="givingSum" class="geo-metric-button rounded-md border border-ink/20 px-3 py-2 text-sm font-bold text-ink hover:border-accent hover:text-accent">Giving sum</button>
                                </div>
                            </div>
                            <% if (!ga4.geography?.length) { %>
                                <p class="mt-5 rounded-md bg-ink/5 px-4 py-3 text-sm text-ink/70">No country-level GA4 data is available for this event date range.</p>
                            <% } else { %>
                                <div id="ga4GeoChart" class="mt-5 h-[30rem] w-full" aria-label="Geographic visits and giving map"></div>
                                <section id="ga4CityStats" class="mt-5 hidden border-t border-ink/10 pt-5" aria-live="polite">
                                    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
                                        <p id="ga4CityStatsTitle" class="text-base font-black text-accent"></p>
                                        <button id="ga4GeoBackButton" type="button" class="rounded-md border border-ink/20 px-3 py-2 text-sm font-bold text-ink hover:border-accent hover:text-accent">Back to world</button>
                                    </div>
                                    <div class="overflow-x-auto rounded-md border border-ink/10">
                                        <table class="w-full text-left text-sm">
                                            <thead class="bg-[#ede6da] text-xs uppercase text-ink/65"><tr><th class="px-4 py-3">City</th><th class="px-4 py-3 text-right">Visits</th><th class="px-4 py-3 text-right">Sessions</th><th class="px-4 py-3 text-right">Giving counts</th><th class="px-4 py-3 text-right">Giving sum</th></tr></thead>
                                            <tbody id="ga4CityStatsRows" class="text-ink/80"></tbody>
                                        </table>
                                    </div>
                                </section>
                            <% } %>
                        </div>
                    <% } %>
                </section>
            </div>
        </main>
    </div>

    <script id="server-data" type="application/json">
        <%- JSON.stringify(data) %>
    </script>
    <script id="selected-event" type="application/json">
        <%- JSON.stringify(selectedEvent) %>
    </script>
    <script id="ga4-data" type="application/json">
        <%- JSON.stringify(ga4) %>
    </script>
    <script>
        // Inject data from server
        const rawData = JSON.parse(document.getElementById('server-data').textContent);
        const selectedEvent = JSON.parse(document.getElementById('selected-event').textContent);
        const ga4 = JSON.parse(document.getElementById('ga4-data').textContent);

        const taipeiDateFormatter = new Intl.DateTimeFormat('en-CA', {
            timeZone: 'Asia/Taipei',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
        });
        const DAY_MS = 24 * 60 * 60 * 1000;

        // Helper to format currency
        const formatCurrency = (amount) => {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'TWD', maximumFractionDigits: 0 }).format(amount);
        };

        const getTaipeiMidnightMs = (dateInput) => {
            const parts = taipeiDateFormatter.formatToParts(dateInput);
            const year = Number(parts.find(p => p.type === 'year')?.value);
            const month = Number(parts.find(p => p.type === 'month')?.value);
            const day = Number(parts.find(p => p.type === 'day')?.value);
            if ([year, month, day].some(v => Number.isNaN(v))) {
                return null;
            }
            return Date.UTC(year, month - 1, day);
        };

        const parseDbDateToUTC = (dateStr) => {
            if (!dateStr) return null;
            const dateOnly = String(dateStr).slice(0, 10);
            const [year, month, day] = dateOnly.split('-').map(Number);
            if ([year, month, day].some(v => Number.isNaN(v))) return null;
            return Date.UTC(year, month - 1, day);
        };

        const toDateOnly = (dateValue) => dateValue ? String(dateValue).slice(0, 10) : null;
        const formatRangeDate = (dateOnly) => {
            const [, month, day] = dateOnly.split('-');
            return `${Number(month)}/${Number(day)}`;
        };
        const buildPeriodDefinitions = (event) => {
            const start = toDateOnly(event?.start_date);
            const end = toDateOnly(event?.end_date);
            if (!start || !end) return [];

            const endMs = Date.parse(`${end}T00:00:00Z`);
            const periods = [];
            for (let currentMs = Date.parse(`${start}T00:00:00Z`); currentMs <= endMs; currentMs += 7 * DAY_MS) {
                const bucketEndMs = Math.min(currentMs + (6 * DAY_MS), endMs);
                const bucketStart = new Date(currentMs).toISOString().slice(0, 10);
                const bucketEnd = new Date(bucketEndMs).toISOString().slice(0, 10);
                periods.push({ start: bucketStart, end: bucketEnd, range: `${formatRangeDate(bucketStart)}-${formatRangeDate(bucketEnd)}` });
            }
            return periods;
        };

        const periodDefinitions = buildPeriodDefinitions(selectedEvent);
        const maxWeeks = periodDefinitions.length;
        const weekLabels = Array.from({ length: maxWeeks }, (_, idx) => `Week ${idx + 1}`);
        const chartWeekLabels = weekLabels;

        const findWeekIndex = (dateOnly) => {
            return periodDefinitions.findIndex(({ start, end }) => dateOnly >= start && dateOnly <= end);
        };

        const todayTaipeiMs = getTaipeiMidnightMs(new Date());
        const pastSevenDays = Array.from({ length: 7 }, (_, index) => {
            const ts = todayTaipeiMs - index * DAY_MS;
            return {
                ts,
                label: taipeiDateFormatter.format(new Date(ts))
            };
        }).reverse();
        const pastSevenSums = pastSevenDays.reduce((acc, { label }) => {
            acc[label] = 0;
            return acc;
        }, {});

        // Process Data
        let totalGiving = 0;
        let totalCount = 0;
        const campusOrder = ['台北分部', '台中分部', '線上分部', '其他'];
        const buildCampusBucket = () => campusOrder.reduce((acc, campus) => {
            acc[campus] = 0;
            return acc;
        }, {});
        const campusSum = buildCampusBucket();
        const campusCount = buildCampusBucket();
        const paymentMethodOrder = ['Apple Pay', 'Google Pay', '信用卡'];
        const buildPaymentMethodBucket = () => paymentMethodOrder.reduce((acc, method) => {
            acc[method] = 0;
            return acc;
        }, {});
        const paymentMethodCount = buildPaymentMethodBucket();
        const paymentMethodAmount = buildPaymentMethodBucket();
        const makeWeekArray = () => Array.from({ length: maxWeeks }, () => 0);
        const weeklySum = makeWeekArray();
        const weeklyCount = makeWeekArray();
        const giverTotals = new Map();

        const normalizePaymentMethod = (rawPaymentType) => {
            const normalized = String(rawPaymentType || '').toLowerCase().trim();
            if (normalized === 'apple_pay') return 'Apple Pay';
            if (normalized === 'google_pay') return 'Google Pay';
            return '信用卡';
        };

        const deriveGiverName = (item) => {
            const candidates = [
                item.receiptname,
                item.receiptName,
                item.name,
                item.email,
                item.phone_number,
                item.phoneNumber
            ];
            const value = candidates.find(candidate => String(candidate || '').trim());
            return value ? String(value).trim() : 'Unknown';
        };

        rawData.forEach(item => {
            const amount = Number(item.amount) || 0;
            const dateOnly = String(item.date).slice(0, 10);

            const weekIndex = findWeekIndex(dateOnly);
            if (weekIndex < 0) return;

            totalGiving += amount;
            totalCount += 1;

            const paymentMethod = normalizePaymentMethod(item.paymenttype || item.paymentType);
            paymentMethodCount[paymentMethod] += 1;
            paymentMethodAmount[paymentMethod] += amount;

            const giverName = deriveGiverName(item);
            const existingGiver = giverTotals.get(giverName) || { amount: 0, count: 0 };
            existingGiver.amount += amount;
            existingGiver.count += 1;
            giverTotals.set(giverName, existingGiver);

            // Campus
            const campusValue = (item.campus || '').trim();
            const campus = campusOrder.includes(campusValue) ? campusValue : '其他';
            campusSum[campus] = (campusSum[campus] || 0) + amount;
            campusCount[campus] = (campusCount[campus] || 0) + 1;

            // Weekly period buckets
            weeklySum[weekIndex] += amount;
            weeklyCount[weekIndex] += 1;

            // Past 7 days (Taipei)
            const donationDateMs = parseDbDateToUTC(item.date);
            if (donationDateMs !== null && todayTaipeiMs !== null) {
                const dayDiff = Math.round((todayTaipeiMs - donationDateMs) / DAY_MS);
                if (dayDiff >= 0 && dayDiff < 7) {
                    const label = taipeiDateFormatter.format(new Date(donationDateMs));
                    pastSevenSums[label] = (pastSevenSums[label] || 0) + amount;
                }
            }
        });

        // Update DOM
        document.getElementById('total-giving-current').textContent = formatCurrency(totalGiving);
        document.getElementById('total-count-current').textContent = totalCount.toLocaleString();

        // Charts Configuration
        Chart.defaults.color = '#000007';
        Chart.defaults.borderColor = 'rgba(0, 0, 7, 0.14)';
        if (window.ChartDataLabels) {
            Chart.register(ChartDataLabels);
        }

        if (ga4.available && ga4.summary) {
            document.getElementById('ga4-active-users').textContent = Number(ga4.summary.activeUsers || 0).toLocaleString();
            document.getElementById('ga4-new-users').textContent = Number(ga4.summary.newUsers || 0).toLocaleString();
            document.getElementById('ga4-sessions').textContent = Number(ga4.summary.sessions || 0).toLocaleString();
            document.getElementById('ga4-page-views').textContent = Number(ga4.summary.pageViews || 0).toLocaleString();

            const dailyChartEl = document.getElementById('ga4DailyTrendChart');
            if (dailyChartEl) {
                new Chart(dailyChartEl, {
                    type: 'line',
                    data: {
                        labels: ga4.daily.map(row => row.date),
                        datasets: [
                            { label: 'Active Users', data: ga4.daily.map(row => row.activeUsers), borderColor: '#e63c23', tension: 0.35 },
                            { label: 'New Users', data: ga4.daily.map(row => row.newUsers), borderColor: '#0689c6', tension: 0.35 },
                            { label: 'Sessions', data: ga4.daily.map(row => row.sessions), borderColor: '#000007', tension: 0.35 },
                            { label: 'Page Views', data: ga4.daily.map(row => row.pageViews), borderColor: '#8b5cf6', tension: 0.35 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: { datalabels: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }

            const postEffectChartEl = document.getElementById('ga4PostEffectChart');
            if (postEffectChartEl && ga4.postEffect) {
                const bucketDefinitions = [
                    { label: 'Same day', test: days => days === 0 },
                    { label: '1 day', test: days => days === 1 },
                    { label: '2–3 days', test: days => days >= 2 && days <= 3 },
                    { label: '4–7 days', test: days => days >= 4 && days <= 7 },
                    { label: '8–14 days', test: days => days >= 8 && days <= 14 },
                    { label: '15–30 days', test: days => days >= 15 && days <= 30 },
                    { label: '31+ days', test: days => days >= 31 }
                ];
                const bucketValues = bucketDefinitions.map(bucket => (ga4.postEffect.rows || [])
                    .filter(row => bucket.test(row.daysToDonation))
                    .reduce((total, row) => total + Number(row.donationEvents || 0), 0));
                new Chart(postEffectChartEl, {
                    type: 'bar',
                    data: {
                        labels: bucketDefinitions.map(bucket => bucket.label),
                        datasets: [{ label: 'Donation Events', data: bucketValues, backgroundColor: '#0689c6', borderRadius: 4 }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false }, datalabels: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            const geoChartEl = document.getElementById('ga4GeoChart');
            if (geoChartEl && Array.isArray(ga4.geography) && ga4.geography.length && window.google?.charts) {
                let selectedGeoMetric = 'activeUsers';
                let selectedGeoCountry = null;
                let geoChartsLoaded = false;
                const geoMetricConfig = {
                    activeUsers: { label: 'Visits', value: row => Number(row.activeUsers || 0) },
                    givingCount: { label: 'Giving counts', value: row => Number(row.givingCount || 0) },
                    givingSum: { label: 'Giving sum', value: row => Number(row.givingSum || 0) }
                };
                const formatGeoValue = (metric, value) => metric === 'givingSum'
                    ? formatCurrency(value)
                    : Number(value || 0).toLocaleString();

                const drawGeoChart = () => {
                    const metric = geoMetricConfig[selectedGeoMetric];
                    const data = new google.visualization.DataTable();
                    data.addColumn('string', 'Country');
                    data.addColumn('number', metric.label);
                    data.addColumn({ type: 'string', role: 'tooltip' });
                    data.addRows(ga4.geography.map(row => {
                        const value = metric.value(row);
                        const tooltip = [
                            row.country,
                            `Visits: ${Number(row.activeUsers || 0).toLocaleString()}`,
                            `Giving counts: ${Number(row.givingCount || 0).toLocaleString()}`,
                            `Giving sum: ${formatCurrency(row.givingSum || 0)}`
                        ].join('\n');
                        return [row.countryCode, value, tooltip];
                    }));
                    const chart = new google.visualization.GeoChart(geoChartEl);
                    google.visualization.events.addListener(chart, 'regionClick', event => {
                        const countryCode = String(event.region || '').toUpperCase();
                        if (ga4.geography?.some(country => country.countryCode === countryCode)) {
                            selectedGeoCountry = countryCode;
                            drawGeoChart();
                            renderCityStats();
                        }
                    });
                    chart.draw(data, {
                        region: selectedGeoCountry || 'world',
                        resolution: selectedGeoCountry ? 'provinces' : 'countries',
                        displayMode: 'regions',
                        backgroundColor: '#f8f3ea',
                        datalessRegionColor: '#ede6da',
                        defaultColor: '#ede6da',
                        colorAxis: { colors: ['#d6effa', '#0689c6'] },
                        legend: { textStyle: { color: '#000007' } },
                        tooltip: { textStyle: { color: '#000007', fontName: 'Inter' } }
                    });
                };

                const cityStatsEl = document.getElementById('ga4CityStats');
                const cityStatsTitleEl = document.getElementById('ga4CityStatsTitle');
                const cityStatsRowsEl = document.getElementById('ga4CityStatsRows');
                const renderCityStats = () => {
                    const cities = (ga4.cities || [])
                        .filter(city => city.countryCode === selectedGeoCountry)
                        .sort((a, b) => b.givingSum - a.givingSum || b.activeUsers - a.activeUsers);
                    const country = ga4.geography.find(item => item.countryCode === selectedGeoCountry);
                    if (!country || !cityStatsEl || !cityStatsTitleEl || !cityStatsRowsEl) return;
                    cityStatsTitleEl.textContent = `City stats · ${country.country}`;
                    if (!cities.length) {
                        const row = document.createElement('tr');
                        const cell = document.createElement('td');
                        cell.colSpan = 5;
                        cell.className = 'px-4 py-4 text-center text-ink/60';
                        cell.textContent = 'No city-level GA4 data is available for this country.';
                        row.appendChild(cell);
                        cityStatsRowsEl.replaceChildren(row);
                        cityStatsEl.classList.remove('hidden');
                        return;
                    }
                    cityStatsRowsEl.replaceChildren(...cities.map(city => {
                        const row = document.createElement('tr');
                        row.className = 'border-t border-ink/10';
                        [
                            city.city,
                            Number(city.activeUsers || 0).toLocaleString(),
                            Number(city.sessions || 0).toLocaleString(),
                            Number(city.givingCount || 0).toLocaleString(),
                            formatCurrency(city.givingSum || 0)
                        ].forEach((value, index) => {
                            const cell = document.createElement('td');
                            cell.className = `px-4 py-3${index ? ' text-right' : ''}`;
                            cell.textContent = value;
                            row.appendChild(cell);
                        });
                        return row;
                    }));
                    cityStatsEl.classList.remove('hidden');
                };

                google.charts.load('current', { packages: ['geochart'] });
                google.charts.setOnLoadCallback(() => {
                    geoChartsLoaded = true;
                    drawGeoChart();
                });
                document.querySelectorAll('.geo-metric-button').forEach(button => {
                    button.addEventListener('click', () => {
                        selectedGeoMetric = button.dataset.geoMetric;
                        document.querySelectorAll('.geo-metric-button').forEach(item => {
                            const isSelected = item === button;
                            item.classList.toggle('bg-accent', isSelected);
                            item.classList.toggle('text-white', isSelected);
                            item.classList.toggle('border', !isSelected);
                            item.classList.toggle('border-ink/20', !isSelected);
                            item.classList.toggle('text-ink', !isSelected);
                        });
                        if (geoChartsLoaded) drawGeoChart();
                    });
                });
                document.getElementById('ga4GeoBackButton')?.addEventListener('click', () => {
                    selectedGeoCountry = null;
                    cityStatsEl?.classList.add('hidden');
                    if (geoChartsLoaded) drawGeoChart();
                });
            }
        }

        // Campus Charts
        const campusLabels = campusOrder;
        const campusSumData = campusLabels.map(l => campusSum[l] || 0);
        const campusCountData = campusLabels.map(l => campusCount[l] || 0);

        new Chart(document.getElementById('campusSumChart'), {
            type: 'bar',
            data: {
                labels: campusLabels,
                datasets: [
                    {
                        label: 'Total',
                        data: campusSumData,
                        backgroundColor: '#e63c23',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    datalabels: { display: false }
                }
            }
        });

        new Chart(document.getElementById('campusCountChart'), {
            type: 'bar',
            data: {
                labels: campusLabels,
                datasets: [
                    {
                        label: 'Count',
                        data: campusCountData,
                        backgroundColor: '#e63c23',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    datalabels: {
                        anchor: 'end',
                        align: 'end',
                        color: '#000007',
                        formatter: (value) => value.toLocaleString()
                    }
                }
            }
        });

        const paymentMethodColors = ['#e63c23', '#0689c6', '#000007'];

        const paymentMethodCountChartEl = document.getElementById('paymentMethodCountChart');
        if (paymentMethodCountChartEl) {
            const paymentMethodCountData = paymentMethodOrder.map(method => paymentMethodCount[method] || 0);
            new Chart(paymentMethodCountChartEl, {
                type: 'pie',
                data: {
                    labels: paymentMethodOrder,
                    datasets: [
                        {
                            data: paymentMethodCountData,
                            backgroundColor: paymentMethodColors,
                            borderWidth: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: (context) => {
                                    const value = context.parsed;
                                    const total = paymentMethodCountData.reduce((acc, v) => acc + v, 0) || 1;
                                    const pct = ((value / total) * 100).toFixed(1);
                                    return `${context.label}: ${value.toLocaleString()} (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        const paymentMethodAmountChartEl = document.getElementById('paymentMethodAmountChart');
        if (paymentMethodAmountChartEl) {
            const paymentMethodAmountData = paymentMethodOrder.map(method => paymentMethodAmount[method] || 0);
            new Chart(paymentMethodAmountChartEl, {
                type: 'pie',
                data: {
                    labels: paymentMethodOrder,
                    datasets: [
                        {
                            data: paymentMethodAmountData,
                            backgroundColor: paymentMethodColors,
                            borderWidth: 0
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: (context) => {
                                    const value = context.parsed;
                                    const total = paymentMethodAmountData.reduce((acc, v) => acc + v, 0) || 1;
                                    const pct = ((value / total) * 100).toFixed(1);
                                    return `${context.label}: ${formatCurrency(value)} (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        const topGiversChartEl = document.getElementById('topGiversChart');
        if (topGiversChartEl) {
            const topGivers = Array.from(giverTotals.entries())
                .map(([name, stats]) => ({
                    name,
                    amount: stats.amount,
                    count: stats.count
                }))
                .sort((a, b) => b.amount - a.amount || b.count - a.count || a.name.localeCompare(b.name))
                .slice(0, 30);

            new Chart(topGiversChartEl, {
                type: 'bar',
                data: {
                    labels: topGivers.map(giver => giver.name),
                    datasets: [
                        {
                            label: 'Total Amount',
                            data: topGivers.map(giver => giver.amount),
                            counts: topGivers.map(giver => giver.count),
                            backgroundColor: '#0689c6',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        datalabels: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (context) => {
                                    const count = context.dataset.counts?.[context.dataIndex] || 0;
                                    return `${formatCurrency(context.parsed.x || 0)} / ${count.toLocaleString()} gifts`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: {
                                callback: (value) => formatCurrency(value)
                            }
                        },
                        y: {
                            ticks: {
                                autoSkip: false
                            }
                        }
                    }
                }
            });
        }

        // Weekly Trend Chart
        const periodSumData = weeklySum;
        const periodCountData = weeklyCount;
        const periodRanges = Array.from({ length: maxWeeks }, (_, idx) => periodDefinitions[idx]?.range || '-');

        new Chart(document.getElementById('weeklyTrendChart'), {
            type: 'line',
            data: {
                labels: chartWeekLabels,
                datasets: [
                    {
                        label: 'Amount',
                        data: periodSumData,
                        borderColor: '#e63c23',
                        backgroundColor: 'transparent',
                        ranges: periodRanges,
                        fill: false,
                        yAxisID: 'y',
                        tension: 0.4,
                        datalabels: { display: false }
                    },
                    {
                        label: 'Count',
                        data: periodCountData,
                        borderColor: '#0689c6',
                        ranges: periodRanges,
                        backgroundColor: 'transparent',
                        yAxisID: 'y1',
                        tension: 0.4,
                        borderDash: [6, 6],
                        datalabels: {
                            anchor: 'end',
                            align: 'bottom',
                            color: '#000007',
                            formatter: (value) => value.toLocaleString()
                        }
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: { display: true },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const datasetLabel = context.dataset.label || '';
                                const value = context.formattedValue;
                                const range = context.dataset.ranges?.[context.dataIndex];
                                const rangeSuffix = range && range !== '-' ? ` (${range})` : '';
                                return `${datasetLabel}: ${value}${rangeSuffix}`;
                            }
                        }
                    },
                    datalabels: {
                        clip: true
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: 'Amount ($)' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        grid: { drawOnChartArea: false },
                        title: { display: true, text: 'Count' }
                    }
                }
            }
        });

        // Populate Table
        const tableBody = document.getElementById('period-table-body');
        weekLabels.forEach((key, idx) => {
            const tr = document.createElement('tr');
            tr.className = "border-b border-ink/10";
            tr.innerHTML = `
                <td class="px-6 py-4 font-medium">${key} <span class="text-ink/50">(${periodRanges[idx]})</span></td>
                <td class="px-6 py-4 text-right">${formatCurrency(periodSumData[idx])}</td>
                <td class="px-6 py-4 text-right">${periodCountData[idx]}</td>
            `;
            tableBody.appendChild(tr);
        });

        new Chart(document.getElementById('pastSevenDaysChart'), {
            type: 'line',
            data: {
                labels: pastSevenDays.map(({ label }) => label),
                datasets: [
                    {
                        label: 'Amount',
                        data: pastSevenDays.map(({ label }) => pastSevenSums[label] || 0),
                        borderColor: '#e63c23',
                        backgroundColor: 'rgba(230, 60, 35, 0.12)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#e63c23',
                        pointBorderColor: '#e63c23',
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    datalabels: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => formatCurrency(context.parsed.y || 0)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: (value) => formatCurrency(value)
                        }
                    }
                }
            }
        });

    </script>
</body>

</html>
